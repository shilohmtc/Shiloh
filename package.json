{
  "name": "whatsapp-shiloh-bot",
  "version": "2.0.0",
  "description": "Production-ready WhatsApp AI Bot",
  "main": "app.js",
  "type": "commonjs",
  "engines": {
    "node": "24.14.1"
  },
  "scripts": {
    "start": "node scripts/verify-migrations.js && node -r ./src/services/receptionPrincipalAudit780.js -r ./src/bootstrap/adminClientLookupNamePatch.js -r ./src/bootstrap/adminProvisionalClientBookingPatch.js -r ./src/bootstrap/adminBookingNaturalDatePatch.js -r ./src/bootstrap/adminBookingChangeConfirmationPatch.js -r ./src/bootstrap/adminBookingChangeConfirmationAuthPatch.js -r ./src/bootstrap/adminBookingChangeConfirmationCommitPatch.js -r ./src/bootstrap/adminManualStartTimePickerPatch.js -r ./src/bootstrap/adminBookingProviderGuardPatch.js -r ./src/bootstrap/adminBookingCustomerNotificationPatch.js -r ./src/bootstrap/adminBookingTypedTimePickerPatch.js -r ./src/bootstrap/clientRescheduleStartBoundaryPatch.js -r ./src/bootstrap/clientRescheduleApprovedNotificationPatch.js -r ./src/bootstrap/clientRescheduleApprovalPatch.js -r ./src/bootstrap/adminBlockTimePatch.js -r ./src/bootstrap/adminUxStandardizationPatch.js -r ./src/bootstrap/clientCouplesPackagesPatch.js app.js",
    "dev": "node scripts/verify-migrations.js && nodemon --exec \"node -r ./src/bootstrap/adminClientLookupNamePatch.js -r ./src/bootstrap/adminProvisionalClientBookingPatch.js -r ./src/bootstrap/adminBookingNaturalDatePatch.js -r ./src/bootstrap/adminBookingChangeConfirmationPatch.js -r ./src/bootstrap/adminBookingChangeConfirmationAuthPatch.js -r ./src/bootstrap/adminBookingChangeConfirmationCommitPatch.js -r ./src/bootstrap/adminManualStartTimePickerPatch.js -r ./src/bootstrap/adminBookingProviderGuardPatch.js -r ./src/bootstrap/adminBookingCustomerNotificationPatch.js -r ./src/bootstrap/adminBookingTypedTimePickerPatch.js -r ./src/bootstrap/clientRescheduleStartBoundaryPatch.js -r ./src/bootstrap/clientRescheduleApprovedNotificationPatch.js -r ./src/bootstrap/clientRescheduleApprovalPatch.js -r ./src/bootstrap/adminBlockTimePatch.js -r ./src/bootstrap/adminUxStandardizationPatch.js -r ./src/bootstrap/clientCouplesPackagesPatch.js\" app.js",
    "db:migrate": "node scripts/migrate.js",
    "maintenance": "node scripts/maintenance.js",
    "test:maintenance-framework": "node --test tests/maintenance-operation-framework.test.js",
    "test:controlled-release-migration": "node --test tests/controlled-release-migration-gate.test.js",
    "test:e2e:booking-confirmation": "node scripts/run-controlled-booking-confirmation-e2e.js",
    "test": "node --test tests/*.test.js",
    "test:browser:appointment-authority": "node scripts/calendar-appointment-authority-browser-proof.js",
    "test:ux": "playwright test --config=playwright.ux.config.js",
    "test:public-website": "node --test tests/public-website-v1.test.js",
    "lint": "eslint .",
    "format:check": "prettier --check eslint.config.js knip.json lighthouserc.cjs scripts/lighthouse-production-audit.js .github/dependabot.yml .github/workflows/maintenance-quality.yml .github/workflows/lighthouse.yml",
    "analyze:unused": "knip --production --include files,dependencies,unlisted --max-show-issues 50",
    "audit:production": "npm audit --omit=dev --audit-level=high",
    "lighthouse:ci": "node scripts/lighthouse-production-audit.js",
    "playwright:install": "playwright install chromium",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "keywords": [
    "whatsapp",
    "meta",
    "openai"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@sentry/node": "^10.74.0",
    "axios": "^1.20.0",
    "dotenv": "^17.2.1",
    "express": "^5.1.0",
    "lucide": "1.44.0",
    "mammoth": "^1.12.2",
    "multer": "^2.3.0",
    "openai": "7.15.0",
    "pdf-parse": "^1.1.1",
    "pg": "^8.23.0",
    "pino": "^10.1.0",
    "qrcode": "1.5.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@emnapi/core": "1.11.3",
    "@emnapi/runtime": "1.11.3",
    "@playwright/test": "1.63.0",
    "@storybook/addon-a11y": "^10.6.0",
    "@storybook/html-vite": "^10.6.0",
    "eslint": "10.10.0",
    "globals": "17.12.0",
    "knip": "6.35.1",
    "lighthouse": "13.4.1",
    "nodemon": "^3.1.10",
    "prettier": "3.9.6",
    "storybook": "^10.6.0"
  },
  "overrides": {
    "@xmldom/xmldom": "0.8.15",
    "qs": "6.16.0"
  }
}
